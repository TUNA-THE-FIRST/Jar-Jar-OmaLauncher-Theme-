widget "booma bandolier" {
  meta { owl: 10; description: "The battery as a bandolier of Gungan boomas: one glowing ball per fifth of charge, sparking while it charges"; version: "1.0"; license: "MIT"; category: "system" }
  page: 1
  order: 3
  size: 6x2
  minSize: 4x2
  padding: 10
  @font lilita

  source bat = android.battery
  let level = bat.level ?? 0
  let charging = bat.charging ?? false
  let low = level < 20 && !charging

  @include power

  Row {
    gap: 8
    fill: true
    align: center
    Column {
      weight: 1
      fill: height
      gap: 2
      Text { text: "BOOMA BANDOLIER"; font: lilita; fontSize: 12; color: muted; letterSpacing: 2; maxLines: 1 }
      Bandolier { level: level; charging: charging; weight: 1 }
    }
    Column {
      width: 92
      gap: 0
      align: end
      justify: center
      Text { text: "${round(level)}%"; font: lilita; fontSize: 38; color: low ? bright_red : charging ? bright_green : bright_blue; align: end; maxLines: 1 }
      Text { text: charging ? "CHARGING" : low ? "BOOMAS LOW" : "ARMED"; style: label; color: charging ? green : low ? red : muted; letterSpacing: 1; align: end; maxLines: 1 }
      Text { text: bat.temp != null ? "${round(bat.temp)}°C" : ""; style: label; color: muted; align: end; maxLines: 1 }
    }
  }
}
